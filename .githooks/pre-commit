#!/bin/sh
# Local gate. Enabled by: git config core.hooksPath .githooks
#
# Rebuilds the CSP if index.html changed, then runs the regression scan.
# Bypass with `git commit --no-verify` if you really need to.
set -e

if git diff --cached --name-only | grep -q '^web/public/index.html$'; then
  echo "pre-commit: index.html changed - regenerating CSP hashes"
  node tools/build-csp.mjs
  git add web/public/_headers
fi

node tools/scan.mjs

# The behavioural suite. scan.mjs checks that the controls are still WRITTEN a
# particular way; these run the real code and check it BEHAVES - a 5000-key PUT
# cannot wedge sync, September is not answered from August, fitness is not seeded
# at zero, a tap mid-sync survives, and scan.mjs itself still fails when any of it
# is put back. Node built-ins only, so there is nothing to install.
node tools/tests/run.mjs
